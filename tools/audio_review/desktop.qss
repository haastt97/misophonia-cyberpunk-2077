QWidget { background: #191b1b; color: #eae7df; }
QLabel#heading { font-size: 26px; font-weight: 700; }
QLabel#detailTitle { font-size: 17px; font-weight: 650; }
QLabel[quiet="true"] { color: #a7ada7; }
QFrame#panel, QTableWidget, QListWidget { background: #202323; }
QFrame#panel { border: 1px solid #3a4140; border-radius: 9px; }
QFrame#panel QLabel { background: transparent; }
QLineEdit, QComboBox, QPushButton {
    padding: 5px 8px; min-height: 20px; background: #252929;
    border: 1px solid #454d4b; border-radius: 5px;
}
QPushButton:hover { background: #363c3b; }
QPushButton:disabled, QComboBox:disabled { color: #858b86; background: #242626; }
QLineEdit:focus, QComboBox:focus, QPushButton:focus { border-color: #f1c97d; }
QPushButton#candidate { color: #ffaaa7; }
QPushButton#candidate:checked { color: #fff0ee; background: #6d2d32; border-color: #ce666e; }
QPushButton#standIn { color: #9ee2ad; }
QPushButton#standIn:checked { color: #e5ffeb; background: #264b37; border-color: #5d9a72; }
QPushButton#standIn:disabled { color: #858b86; }
QPushButton#playActive { border-color: #e1b96d; color: #f6d899; }
QTableWidget, QListWidget { border: 1px solid #39403f; border-radius: 5px; }
QTableWidget { alternate-background-color: #232727; }
QHeaderView::section { background: #262b2a; padding: 7px; border: 0; color: #c5cbc2; }
QTableWidget::item { padding: 0 7px; }
QSlider::groove:horizontal { height: 5px; background: #4a5250; }
QSlider::handle:horizontal { width: 11px; margin: -4px 0; background: #e4bd75; border-radius: 4px; }
